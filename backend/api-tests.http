### Health Check
GET http://localhost:8090/actuator/health

### Log in with a PIN (seeded: admin 1234, manager1 5678, server1 9012, server2 3456, kitchen1 7890)
# The response token goes in the Authorization header of the calls below.
POST http://localhost:8090/api/auth/login
Content-Type: application/json

{
  "pin": "7890"
}

### Test Order Creation (will implement next)
POST http://localhost:8090/api/orders
Content-Type: application/json

{
  "orderType": "DINE_IN",
  "tableId": "123e4567-e89b-12d3-a456-426614174000",
  "serverId": "123e4567-e89b-12d3-a456-426614174001",
  "items": []
}

### Cash payment (needs a FIRED/PREPARING/READY order and a SERVER/MANAGER/ADMIN token from /api/auth)
# Reuse the same Idempotency-Key when retrying the same attempt; a new attempt gets a new UUID.
POST http://localhost:8090/api/orders/{{orderId}}/payments
Authorization: Bearer {{token}}
Idempotency-Key: 6f1c2b8e-0d4a-4c1e-9a77-2b5d0e9c1a01
Content-Type: application/json

{
  "method": "CASH",
  "amount": 21.00,
  "tip": 3.00,
  "tendered": 30.00
}


### Move an order along the kitchen path (needs a token from /api/auth)
# Allowed: DRAFT -> SUBMITTED, FIRED -> PREPARING -> READY, or the same status again (no-op).
# Anything else is 409: fire with POST /api/orders/{id}/fire, complete by payment, cancel with POST /api/orders/{id}/cancel.
PATCH http://localhost:8090/api/orders/{{orderId}}/status?status=PREPARING
Authorization: Bearer {{token}}


### Cancel an order (SERVER/MANAGER/ADMIN token from /api/auth; reason is required)
# A SERVER may cancel DRAFT/SUBMITTED; once fired only a MANAGER or ADMIN. KITCHEN never.
# 409 if the order is COMPLETED/CANCELLED or has a captured payment (refund or void it first).
POST http://localhost:8090/api/orders/{{orderId}}/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Guest left before ordering"
}


### Kitchen item status (KITCHEN/MANAGER/ADMIN token; 403 for a SERVER; 409 once the order is no longer FIRED/PREPARING/READY)
# The kitchen screen reads GET /api/orders/active with the same token and sends it on the STOMP CONNECT frame.
PATCH http://localhost:8090/api/orders/{{orderId}}/items/{{itemId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "PREPARING"
}
